{
    "format": "music-visualizer-project",
    "version": 2,
    "canvas": { "width": 1280, "height": 720, "color": "#ff000000" },
    "layers": [
        {
            "type": "audio",
            "props": {
                "name": "Audio provider",
                "layerVisible": true, "layerOpacity": 1, "blendMode": "normal",
                "posX": 0.5, "posY": 0.5, "sizeW": 1, "sizeH": 1, "layerRotation": 0,

                "bandCount": 32,
                "windowMs": 120,
                "averageCount": 1,

                "minHz": -72,
                "maxHz": 238,
                "hzLinearFactor": 1.0,

                "bandMeasure": "rms",
                "amplitudeMode": "linear",
                "linearGain": 1.45,
                "linearFloor": 0.02,
                "lowFreqMagnitude": 1.0,
                "tiltDbPerOctave": 0.0,
                "bandNormalization": 0.0,
                "gateDb": 0.0,
                "scalingCurve": "power",
                "gamma": 1.7,

                "smoothingMode": "attackDecay",
                "attackMs": 5,
                "decayMs": 160,
                "spatialSmoothing": 0.0,
                "floorLevel": 0.0
            }
        },
        {
            "type": "background",
            "props": {
                "name": "Backdrop",
                "layerVisible": true, "layerOpacity": 1, "blendMode": "normal",
                "posX": 0.5, "posY": 0.5, "sizeW": 1, "sizeH": 1, "layerRotation": 0,
                "color": "#ff000000", "imageSource": "", "fillMode": "crop"
            }
        },
        {
            "type": "bars",
            "props": {
                "name": "Spectrum",
                "layerVisible": true, "layerOpacity": 1, "blendMode": "normal",
                "posX": 0.5, "posY": 0.598, "sizeW": 1.0, "sizeH": 0.62,
                "layerRotation": 0,

                "providerId": 0,
                "mirrorSpectrum": true,
                "orientation": "linear",
                "growUpward": true,
                "barWidthRatio": 1.0,
                "cornerRadius": 0,
                "minHeight": 0.01,
                "maxHeight": 1.0,
                "innerRadius": 0.35,

                "colorMode": "solid",
                "colorA": "#ffffffff",
                "colorB": "#ffffffff",
                "reactiveBrightness": 0
            }
        }
    ]
}
