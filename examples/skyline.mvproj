{
    "format": "music-visualizer-project",
    "version": 2,
    "canvas": {
        "width": 1920,
        "height": 1080,
        "color": "#ff0a0a14"
    },
    "layers": [
        {
            "type": "audio",
            "props": {
                "name": "Audio provider",
                "layerVisible": true,
                "layerOpacity": 1,
                "blendMode": "normal",
                "posX": 0.5, "posY": 0.5, "sizeW": 1, "sizeH": 1, "layerRotation": 0,

                "bandCount": 34,
                "fftSize": 4096,
                "minHz": 45,
                "maxHz": 12000,

                "bandMeasure": "rms",
                "bandNormalization": 0.7,
                "normalizationTau": 3.0,
                "tiltDbPerOctave": 0.0,
                "floorDb": -78,
                "ceilingDb": -4,
                "gateDb": 8,
                "scalingCurve": "power",
                "gamma": 3.0,

                "attackMs": 5,
                "decayMs": 220,
                "spatialSmoothing": 0.15,
                "floorLevel": 0.012
            }
        },
        {
            "type": "background",
            "props": {
                "name": "Backdrop",
                "layerVisible": true, "layerOpacity": 1, "blendMode": "normal",
                "posX": 0.5, "posY": 0.5, "sizeW": 1, "sizeH": 1, "layerRotation": 0,
                "color": "#ff0a0a14", "imageSource": "", "fillMode": "crop"
            }
        },
        {
            "type": "bars",
            "props": {
                "name": "Skyline",
                "layerVisible": true, "layerOpacity": 1, "blendMode": "normal",
                "posX": 0.5, "posY": 0.8, "sizeW": 1.0, "sizeH": 0.4,
                "layerRotation": 0,

                "providerId": 0,
                "mirrorSpectrum": true,
                "orientation": "linear",
                "growUpward": true,
                "barWidthRatio": 1.0,
                "cornerRadius": 0,
                "minHeight": 0.02,
                "maxHeight": 0.95,
                "innerRadius": 0.35,

                "colorMode": "solid",
                "colorA": "#ffe8ecff",
                "colorB": "#ffe8ecff",
                "reactiveBrightness": 0
            }
        }
    ]
}
