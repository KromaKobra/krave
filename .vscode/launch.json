{
    // Launch configurations for the music visualizer.
    //
    // The list is split by host, because the debug engines are different types
    // and "type" cannot be overridden per-platform. Only the configs matching
    // your host will run; pick the ones with your platform in the name.
    //
    // Linux uses CodeLLDB ("lldb", vadimcn.vscode-lldb) rather than the more
    // usual cppdbg. cppdbg comes from ms-vscode.cpptools, which is proprietary
    // and is not published to Open VSX -- so it cannot be installed on VSCodium
    // at all. CodeLLDB is on Open VSX and debugs GCC output fine. On NixOS
    // install it from nixpkgs (vscode-extensions.vadimcn.vscode-lldb); the
    // marketplace build ships an unpatched prebuilt binary that will not run.
    //
    // The in-tree binary is not wrapped, so it needs the Qt plugin and QML
    // import paths from the dev shell. scripts/build.sh writes them to
    // build/<preset>/dev.env on every build, and each config reads that as its
    // envFile -- the preLaunchTask guarantees it is current.
    //
    // Windows: every config puts Qt's bin directory on PATH -- the app links
    // against Qt6Core.dll and friends, which live there and are not on the
    // system PATH. Without it the process dies at startup with no message.
    //
    // cwd is the workspace root so relative paths like "media/testtone.mp3" and
    // "examples/neon.mvproj" resolve the way they do from the shell.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch editor (Linux)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/linux-debug/bin/krave",
            "args": [],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/build/linux-debug/dev.env",
            "terminal": "integrated"
            // QML binding loops and type errors are already reported by
            // default. Do not add QT_LOGGING_RULES=qt.qml.*=true here: it
            // turns on import tracing and buries them.
        },
        {
            "name": "Launch editor, open a track… (Linux)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/linux-debug/bin/krave",
            "args": [
                "--project", "${input:projectFile}",
                "--audio", "${input:audioFile}"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/build/linux-debug/dev.env",
            "terminal": "integrated"
        },
        {
            "name": "Render headless, no window (Linux)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/linux-debug/bin/krave",
            "args": [
                "--render",
                "--audio", "${input:audioFile}",
                "--project", "${input:projectFile}",
                "--out", "${input:outputFile}",
                "--fps", "${input:fps}"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/build/linux-debug/dev.env",
            "terminal": "integrated"
        },
        {
            "name": "Debug tst_fft (Linux)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/linux-debug/bin/tst_fft",
            "args": [],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/build/linux-debug/dev.env",
            "terminal": "integrated"
        },
        {
            "name": "Debug tst_project (Linux)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/linux-debug/bin/tst_project",
            "args": [],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/build/linux-debug/dev.env",
            // tst_project builds QGuiApplication-owned types but opens no
            // window. CodeLLDB applies "env" on top of "envFile".
            "env": { "QT_QPA_PLATFORM": "offscreen" },
            "terminal": "integrated"
        },
        {
            "name": "Launch editor (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/Debug/bin/krave.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis",
            "symbolSearchPath": "C:\\Qt\\6.8.3\\msvc2022_64\\bin"
        },
        {
            "name": "Launch editor, open a track… (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/Debug/bin/krave.exe",
            "args": [
                "--project", "${input:projectFile}",
                "--audio", "${input:audioFile}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis"
        },
        {
            "name": "Render headless, no window (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/Debug/bin/krave.exe",
            "args": [
                "--render",
                "--audio", "${input:audioFile}",
                "--project", "${input:projectFile}",
                "--out", "${input:outputFile}",
                "--fps", "${input:fps}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis"
        },
        {
            "name": "Launch editor, release (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (release)",
            "program": "${workspaceFolder}/build/RelWithDebInfo/bin/krave.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis"
        },
        {
            "name": "Debug tst_fft (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/Debug/bin/tst_fft.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis"
        },
        {
            "name": "Debug tst_project (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build (debug)",
            "program": "${workspaceFolder}/build/Debug/bin/tst_project.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "environment": [
                { "name": "PATH", "value": "C:\\Qt\\6.8.3\\msvc2022_64\\bin;${env:PATH}" }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis"
        }
    ],
    "inputs": [
        {
            "id": "audioFile",
            "type": "promptString",
            "description": "Audio track (mp3, wav, flac, aac, m4a, ogg)",
            "default": "media/testtone.mp3"
        },
        {
            "id": "projectFile",
            "type": "promptString",
            "description": "Visualizer project (.mvproj)",
            "default": "examples/neon.mvproj"
        },
        {
            "id": "outputFile",
            "type": "promptString",
            "description": "Output video (.mp4 or .mov)",
            "default": "media/out.mp4"
        },
        {
            "id": "fps",
            "type": "pickString",
            "description": "Frame rate",
            "options": ["24", "30", "60"],
            "default": "30"
        }
    ]
}
